<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SADU - <%= accion %> Usuario</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header>
        <h1>SADU - Sistema Administrativo Documental Unificado</h1>
        <nav>
            <a href="/documentos">Documentos</a>
            <a href="/usuarios">Usuarios</a>
        </nav>
    </header>

    <main>
        <h2><%= accion %> Usuario</h2>

        <form action="" method="POST" class="formulario">
            <div class="campo">
                <label for="nombre">Nombre completo</label>
                <input type="text" id="nombre" name="nombre"
                    value="<%= usuario ? usuario.nombre : '' %>"
                    placeholder="Nombre del funcionario" required>
            </div>

            <div class="campo">
                <label for="email">Correo electrónico</label>
                <input type="email" id="email" name="email"
                    value="<%= usuario ? usuario.email : '' %>"
                    placeholder="correo@sanantonio.gov.co" required>
            </div>

            <div class="campo">
                <label for="rol">Rol</label>
                <select id="rol" name="rol" required>
                    <% ['Administrador','Funcionario','Consulta Ciudadana'].forEach(r => { %>
                        <option value="<%= r %>" <%= usuario && usuario.rol === r ? 'selected' : '' %>>
                            <%= r %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <% if (!usuario) { %>
            <div class="campo">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password"
                    placeholder="Contraseña" required>
            </div>
            <% } %>

            <div class="acciones">
                <button type="submit" class="btn-primary"><%= accion %></button>
                <a href="/usuarios" class="btn-cancelar">Cancelar</a>
            </div>
        </form>
    </main>
</body>
</html>
