<%- include('../partials/cabecera', { titulo: 'Gestión de Usuarios', usuario, activo: 'usuarios' }) %>

<section class="panel">
    <div class="encabezado-seccion">
        <h2>Usuarios del sistema</h2>
        <a href="/usuarios/nuevo" class="btn-primary">+ Nuevo Usuario</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% if (usuarios && usuarios.length > 0) { %>
                <% usuarios.forEach(u => { %>
                    <tr>
                        <td><%= u.id %></td>
                        <td><%= u.nombre %></td>
                        <td><%= u.email %></td>
                        <td><span class="badge badge-rol"><%= u.rol %></span></td>
                        <td class="celda-acciones">
                            <a href="/usuarios/editar/<%= u.id %>" class="btn-editar">Editar</a>
                            <% if (u.id !== usuario.id) { %>
                            <form action="/usuarios/eliminar/<%= u.id %>" method="POST" style="display:inline">
                                <button type="submit" class="btn-eliminar"
                                    onclick="return confirm('¿Eliminar este usuario?')">
                                    Eliminar
                                </button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5">No hay usuarios registrados.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</section>

<%- include('../partials/pie') %>
