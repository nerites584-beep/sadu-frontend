<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SADU - <%= accion %> Documento</title>
    <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
    <header>
        <h1>SADU - Sistema Administrativo Documental Unificado</h1>
        <nav>
            <a href="/documentos">Documentos</a>
            <a href="/usuarios">Usuarios</a>
        </nav>
    </header>

    <main>
        <h2><%= accion %> Documento</h2>

        <form action="" method="POST" class="formulario">
            <div class="campo">
                <label for="radicado">Radicado</label>
                <input type="text" id="radicado" name="radicado"
                    value="<%= documento ? documento.radicado : '' %>"
                    <%= documento ? 'readonly' : '' %>
                    placeholder="Ej: ALC-2026-003" required>
            </div>

            <div class="campo">
                <label for="titulo">Título del documento</label>
                <input type="text" id="titulo" name="titulo"
                    value="<%= documento ? documento.titulo : '' %>"
                    placeholder="Título del documento" required>
            </div>

            <div class="campo">
                <label for="tipo">Tipo de documento</label>
                <select id="tipo" name="tipo" required>
                    <% const tipos = ['Acuerdo Municipal','Decreto','Resolución','Acta de Comité',
                       'Contrato de Prestación de Servicios','PQRSDF','Oficio de Respuesta',
                       'Memorando Interno','Circular','Informe','Certificación','Constancia'] %>
                    <% tipos.forEach(t => { %>
                        <option value="<%= t %>" <%= documento && documento.tipo === t ? 'selected' : '' %>>
                            <%= t %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="campo">
                <label for="estado">Estado</label>
                <select id="estado" name="estado" required>
                    <% ['Activo','En trámite','Archivado','Anulado'].forEach(e => { %>
                        <option value="<%= e %>" <%= documento && documento.estado === e ? 'selected' : '' %>>
                            <%= e %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="campo">
                <label for="dependencia">Dependencia</label>
                <select id="dependencia" name="dependencia" required>
                    <% const deps = ['Despacho del Alcalde','Secretaría General','Secretaría de Hacienda',
                       'Secretaría de Planeación','Secretaría de Infraestructura','Secretaría de Salud',
                       'Secretaría de Educación','Secretaría de Gobierno','Concejo Municipal',
                       'Personería Municipal','Control Interno','Oficina Jurídica','Tesorería'] %>
                    <% deps.forEach(d => { %>
                        <option value="<%= d %>" <%= documento && documento.dependencia === d ? 'selected' : '' %>>
                            <%= d %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="campo">
                <label for="fecha_registro">Fecha de registro</label>
                <input type="date" id="fecha_registro" name="fecha_registro"
                    value="<%= documento ? documento.fecha_registro : '' %>" required>
            </div>

            <div class="campo">
                <label for="usuario_id">ID de usuario responsable</label>
                <input type="number" id="usuario_id" name="usuario_id"
                    value="<%= documento ? documento.usuario_id : '' %>"
                    placeholder="Ej: 1">
            </div>

            <div class="acciones">
                <button type="submit" class="btn-primary"><%= accion %></button>
                <a href="/documentos" class="btn-cancelar">Cancelar</a>
            </div>
        </form>
    </main>
</body>
</html>
