<%- include('../partials/cabecera', { titulo: 'Gestión de Documentos', usuario, activo: 'documentos' }) %>

<section class="panel">
    <div class="encabezado-seccion">
        <h2>Documentos radicados</h2>
        <% if (usuario.rol === 'Administrador' || usuario.rol === 'Funcionario') { %>
        <a href="/documentos/nuevo" class="btn-primary">+ Nuevo Documento</a>
        <% } %>
    </div>

    <table>
        <thead>
            <tr>
                <th>Radicado</th>
                <th>Título</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Dependencia</th>
                <th>Fecha</th>
                <th>Responsable</th>
                <% if (usuario.rol !== 'Consulta') { %><th>Acciones</th><% } %>
            </tr>
        </thead>
        <tbody>
            <% if (documentos && documentos.length > 0) { %>
                <% documentos.forEach(doc => { %>
                    <tr>
                        <td><span class="badge"><%= doc.radicado %></span></td>
                        <td><%= doc.titulo %></td>
                        <td><%= doc.tipo %></td>
                        <td><span class="badge estado-<%= doc.estado.replace(/[^a-zA-Z]/g,'').toLowerCase() %>"><%= doc.estado %></span></td>
                        <td><%= doc.dependencia %></td>
                        <td><%= doc.fecha_registro %></td>
                        <td><%= doc.usuario_nombre || '—' %></td>
                        <% if (usuario.rol !== 'Consulta') { %>
                        <td class="celda-acciones">
                            <a href="/documentos/editar/<%= doc.id %>" class="btn-editar">Editar</a>
                            <% if (usuario.rol === 'Administrador') { %>
                            <form action="/documentos/eliminar/<%= doc.id %>" method="POST" style="display:inline">
                                <button type="submit" class="btn-eliminar"
                                    onclick="return confirm('¿Eliminar este documento?')">
                                    Eliminar
                                </button>
                            </form>
                            <% } %>
                        </td>
                        <% } %>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="8">No hay documentos registrados.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</section>

<%- include('../partials/pie') %>
