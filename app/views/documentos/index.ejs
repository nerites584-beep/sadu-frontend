<%- include('../partials/cabecera', { titulo: 'Gestión de Documentos', usuario, activo: 'documentos' }) %>

<% const puedeGestionar = usuario.rol === 'Administrador' || usuario.rol === 'Funcionario' %>
<% const consulta = new URLSearchParams(filtros).toString() %>

<section class="panel">
    <%- include('../partials/filtros', { accion: '/documentos', filtros }) %>
</section>

<section class="panel">
    <div class="encabezado-seccion">
        <div>
            <h2>Documentos radicados</h2>
            <p class="resultado-busqueda">
                <%= documentos.length %> documento(s)
                <%= Object.keys(filtros).length > 0 ? 'coinciden con la búsqueda' : 'en total' %>
            </p>
        </div>
        <% if (puedeGestionar) { %>
        <div class="botones-encabezado">
            <a href="/reportes/exportar/csv<%= consulta ? '?' + consulta : '' %>" class="btn-secundario">⬇ Excel</a>
            <a href="/reportes/exportar/pdf<%= consulta ? '?' + consulta : '' %>" class="btn-secundario">⬇ PDF</a>
            <a href="/documentos/nuevo" class="btn-primary">+ Nuevo Documento</a>
        </div>
        <% } %>
    </div>

    <div class="tabla-responsive">
    <table>
        <thead>
            <tr>
                <th>Radicado</th>
                <th>Título</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Dependencia</th>
                <th>Fecha</th>
                <th>Responsable</th>
                <% if (puedeGestionar) { %><th>PDF</th><th>Acciones</th><% } %>
            </tr>
        </thead>
        <tbody>
            <% if (documentos && documentos.length > 0) { %>
                <% documentos.forEach(doc => { %>
                    <tr>
                        <td><span class="badge"><%= doc.radicado %></span></td>
                        <td><%= doc.titulo %></td>
                        <td><%= doc.tipo %></td>
                        <td><span class="badge estado-<%= doc.estado.replace(/[^a-zA-Z]/g,'').toLowerCase() %>"><%= doc.estado %></span></td>
                        <td><%= doc.dependencia %></td>
                        <td><%= doc.fecha_registro %></td>
                        <td><%= doc.usuario_nombre || '—' %></td>
                        <% if (puedeGestionar) { %>
                        <td>
                            <% if (doc.archivo) { %>
                            <a href="/documentos/<%= doc.id %>/archivo" target="_blank" rel="noopener" class="btn-pdf">Ver PDF</a>
                            <% } else { %>
                            <span class="sin-archivo">Sin PDF</span>
                            <% } %>
                        </td>
                        <td class="celda-acciones">
                            <a href="/documentos/editar/<%= doc.id %>" class="btn-editar">Editar</a>
                            <% if (usuario.rol === 'Administrador') { %>
                            <form action="/documentos/eliminar/<%= doc.id %>" method="POST" style="display:inline">
                                <button type="submit" class="btn-eliminar"
                                    onclick="return confirm('¿Eliminar el documento <%= doc.radicado %>?')">
                                    Eliminar
                                </button>
                            </form>
                            <% } %>
                        </td>
                        <% } %>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="9">
                        <%= Object.keys(filtros).length > 0
                            ? 'Ningún documento coincide con la búsqueda. Pruebe con otros filtros.'
                            : 'No hay documentos registrados.' %>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
    </div>
</section>

<%- include('../partials/pie') %>
